LOCATIONIQ_KEY=your_locationiq_key_here
GROQ_API_KEY=your_groq_key_here
# Free account at geonames.org/login — used only as a fallback natural-feature
# source when Overpass finds nothing. Without this, requests fall back to the
# shared public "demo" account, which is rate-limited across every app using
# it and fails often in practice.
GEONAMES_USERNAME=your_geonames_username_here
PORT=3001
